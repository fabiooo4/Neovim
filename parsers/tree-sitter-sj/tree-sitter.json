{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sj",
      "camelcase": "Sj",
      "title": "JAVASCRIPT",
      "scope": "source.sj",
      "file-types": [
        "sj"
      ],
      "injection-regex": "^sj$",
      "class-name": "TreeSitterSj"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "JAVASCRIPT Syntax Highlighting",
    "authors": [
      {
        "name": "fabiooo4 MagiHotline"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-sj"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}